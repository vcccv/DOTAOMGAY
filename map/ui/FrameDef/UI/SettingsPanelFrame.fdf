
// -- INCLUDE FILES ---------------------------------------------------------

IncludeFile "UI\FrameDef\UI\EscMenuTemplates.fdf",
IncludeFile "UI\FrameDef\UI\EscMenuMainPanel.fdf",
IncludeFile "UI\FrameDef\UI\UpperButtonBar.fdf",

// -- LOCAL TEMPLATES -------------------------------------------------------

// -- FRAMES ----------------------------------------------------------------

Texture "SettingsMenuButtonBackground" {
    File "UpperMenuButtonTexture",
    TexCoord 0.0, 0.6640625, 0.0, 0.171875,
}
Texture "SettingsMenuButtonPushedBackground" {
    File "UpperMenuButtonTexture",
    TexCoord 0.0, 0.6640625, 0.25, 0.421875,
}
Texture "SettingsMenuButtonDisabledBackground" {
    File "UpperMenuButtonTexture",
    TexCoord 0.0, 0.6640625, 0.5, 0.671875,
}
Texture "SettingsMenuButtonHighlight" {
    File "UpperMenuButtonTexture",
    TexCoord 0.0, 0.6640625, 0.75, 0.921875,
    AlphaMode "ADD",
}

Frame "SIMPLEBUTTON" "SettingsBarButtonTemplate" {
    DecorateFileNames,
    Width 0.0425,
    Height 0.022,
    ButtonPushedTextOffset 0.001 -0.001,
    NormalTexture "SettingsMenuButtonBackground",
    PushedTexture "SettingsMenuButtonPushedBackground",
    DisabledTexture "SettingsMenuButtonDisabledBackground",
    UseHighlight "SettingsMenuButtonHighlight",
}

String "SettingsBarButtonTextTemplate" {
    Font "MasterFont",0.01,
    FontColor 1.0 1.0 1.0,
}

String "SettingsBarButtonDisabledTextTemplate" INHERITS "SettingsBarButtonTextTemplate" {
    FontColor 0.4 0.4 0.4,
}

String "SettingsBarButtonHighlightTextTemplate" INHERITS "SettingsBarButtonTextTemplate" {
    FontColor 1.0 0.83 0.07,
}

Frame "SIMPLEBUTTON" "SettingsBarButton" INHERITS "SettingsBarButtonTemplate" {
    SetPoint TOPLEFT,"UpperButtonBarFrame",TOPLEFT,0.042,-0.022,
    NormalText "SettingsBarButtonTextTemplate" "地图设置",
    DisabledText "SettingsBarButtonDisabledTextTemplate" "地图设置",
    HighlightText "SettingsBarButtonHighlightTextTemplate" "地图设置",
}

Frame "HIGHLIGHT" "SettingsCheckBoxHighLight" {
    SetAllPoints,
    DecorateFileNames,
    HighlightType "FILETEXTURE",
    HighlightAlphaFile "EscMenuCheckBoxCheckHighlight",
    HighlightAlphaMode "BLEND",
}

Frame "GLUECHECKBOX" "SettingsCheckBox" {
    Width  0.024,
    Height 0.024,

    ControlBackdrop "SettingsCheckBoxBackdrop",
    Frame "BACKDROP" "SettingsCheckBoxBackdrop" {
        DecorateFileNames,
        BackdropBlendAll,
        BackdropBackground  "EscMenuCheckBoxBackground",
    }

    ControlDisabledBackdrop "SettingsDisabledCheckBoxBackdrop",
    Frame "BACKDROP" "SettingsDisabledCheckBoxBackdrop" {
        DecorateFileNames,
        BackdropBlendAll,
        BackdropBackground  "EscMenuDisabledCheckBoxBackground",
    }

    ControlPushedBackdrop "SettingsCheckBoxPushedBackdrop",
    Frame "BACKDROP" "SettingsCheckBoxPushedBackdrop" {
        DecorateFileNames,
        BackdropBlendAll,
        BackdropBackground  "EscMenuCheckBoxPushedBackground",
    }

    //CheckBoxCheckHighlight "SettingsCheckHighlightTemplate",
    //Frame "HIGHLIGHT" "SettingsCheckHighlightTemplate" {
    //    DecorateFileNames,
    //    HighlightType "FILETEXTURE",
    //    HighlightAlphaFile "EscMenuCheckBoxCheckHighlight",
    //    HighlightAlphaMode "BLEND",
    //}

    //CheckBoxDisabledCheckHighlight "SettingsDisabledCheckHighlightTemplate",
    //Frame "HIGHLIGHT" "SettingsDisabledCheckHighlightTemplate" {
    //    DecorateFileNames,
    //    HighlightType "FILETEXTURE",
    //    HighlightAlphaFile "EscMenuDisabledCheckHighlight",
    //    HighlightAlphaMode "BLEND",
    //}
}



Frame "FRAME" "SettingsPanelTooltipFrame" {
    Width  0.135,

    Frame "BACKDROP" "SettingsPanelTooltipBackdrop" 
    {
        UseActiveContext,
        SetAllPoints,
        DecorateFileNames,
        BackdropTileBackground,
        BackdropBackground "ToolTipBackground",
        BackdropEdgeFile "ToolTipBorder",
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize 0.01,
        BackdropBackgroundInsets 0.0019 0.0019 0.0019 0.0019,
        BackdropBlendAll,
    }

    Frame "TEXT" "SettingsPanelTooltipText"
    {
        UseActiveContext,
        LayerStyle "IGNORETRACKEVENTS",
        Width 0.125,
        SetPoint TOPLEFT, "SettingsPanelTooltipFrame", TOPLEFT, 0.005, -0.005,
        DecorateFileNames,
        FrameFont "MasterFont", 0.011, "",
        Text "tooltip missing!",
    }

    Frame "TEXT" "SettingsPanelTooltipExtendedText"
    {
        UseActiveContext,
        LayerStyle "IGNORETRACKEVENTS",
        Width 0.125,
        SetPoint TOPLEFT, "SettingsPanelTooltipText", BOTTOMLEFT, 0.0, -0.005,
        DecorateFileNames,
        FrameFont "MasterFont", 0.011, "",
        Text "tooltip missing!",
    }
}

Frame "FRAME" "SettingsPanelFrame" {
    Width  0.475,
	Height 0.3750,
    TabFocusPush,

    Frame "GLUETEXTBUTTON" "SettingsPanelReturnButton" INHERITS WITHCHILDREN "EscMenuButtonTemplate" {
        SetPoint TOPRIGHT, "SettingsPanelFrame", TOPRIGHT, -0.035, -0.035,
        Width 0.18,
        ControlShortcutKey "R",
        TabFocusDefault,

        ButtonText "SettingsPanelReturnButtonText",
        Frame "TEXT" "SettingsPanelReturnButtonText" INHERITS "EscMenuButtonTextTemplate" {
            Text "KEY_RETURN_TO_GAME",
        }
    }
}
